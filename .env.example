NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/capoeira_hub
DATABASE_SSL=false

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# Cloudflare R2 (S3-compatible) storage for User/Group/Section/Event
# images - see src/storage. All five are required for any upload/delete
# image endpoint to work; R2StorageService fails fast at startup if any is
# missing. R2_PUBLIC_URL should point at the bucket's public r2.dev URL in
# development; swap it for a custom domain later without a data migration
# (object keys, not full URLs, are what's stored in the DB - see
# storage/r2-storage.service.ts).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=capohub
R2_PUBLIC_URL=
